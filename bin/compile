#!/usr/bin/env bash
set -euo pipefail

BUILD_DIR=$1
CACHE_DIR=$2

echo "-----> Already Installed dependencies for ImageMagick with EMF"

# apt-get update -y
# apt-get install -y --no-install-recommends \
#   build-essential \
#   pkg-config \
#   wget curl ca-certificates \
#   libjpeg-dev libpng-dev libtiff-dev \
#   libxml2-dev libfreetype6-dev \
#   libwmf-dev libglib2.0-dev libcairo2-dev \
#   autoconf automake libtool

VENDOR_DIR=$BUILD_DIR/vendor
mkdir -p $VENDOR_DIR

export PATH="$VENDOR_DIR/bin:$PATH"
export PKG_CONFIG_PATH="$VENDOR_DIR/lib/pkgconfig:$PKG_CONFIG_PATH"
export LD_LIBRARY_PATH="$VENDOR_DIR/lib:$LD_LIBRARY_PATH"
export CPPFLAGS="-I$VENDOR_DIR/include $CPPFLAGS"
export LDFLAGS="-L$VENDOR_DIR/lib $LDFLAGS"

# 1. Build libEMF
LIBEMF_VERSION=1.0
cd /tmp
curl -sSL "https://downloads.sourceforge.net/project/libemf/libEMF/libEMF-${LIBEMF_VERSION}.tar.gz" -o libemf.tar.gz
mkdir libemf && tar -xzf libemf.tar.gz -C libemf --strip-components=1
cd libemf
./configure --prefix=$VENDOR_DIR
make -j$(nproc)
make install

# 2. Build ImageMagick with EMF delegate
IM_VERSION=7.1.1-30
cd /tmp
curl -sSL "https://download.imagemagick.org/ImageMagick/download/releases/ImageMagick-${IM_VERSION}.tar.gz" -o im.tar.gz
mkdir im && tar -xzf im.tar.gz -C im --strip-components=1
cd im

./configure \
  --prefix=$VENDOR_DIR \
  --with-modules \
  --with-jpeg=yes --with-png=yes --with-tiff=yes \
  --with-xml=yes --with-fontconfig=yes --with-freetype=yes \
  CPPFLAGS="$CPPFLAGS" LDFLAGS="$LDFLAGS" PKG_CONFIG_PATH="$PKG_CONFIG_PATH"

make -j$(nproc)
make install

# Add to runtime PATH
mkdir -p $BUILD_DIR/.profile.d
cat > $BUILD_DIR/.profile.d/imagemagick.sh <<EOF
export PATH="\$HOME/vendor/bin:\$PATH"
export LD_LIBRARY_PATH="\$HOME/vendor/lib:\$LD_LIBRARY_PATH"
EOF

echo "-----> Finished building ImageMagick with EMF support"
